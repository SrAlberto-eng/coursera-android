<?xml version="1.0" encoding="utf-8"?>
<!-- Una publicación del timeline: quién la subió, la foto, los likes como huesos y el texto. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/margen_tarjeta"
    android:layout_marginVertical="@dimen/espacio_tarjetas"
    app:cardCornerRadius="6dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.mikhaellopez.circularimageview.CircularImageView
            android:id="@+id/img_usuario"
            android:layout_width="@dimen/tamano_foto_usuario"
            android:layout_height="@dimen/tamano_foto_usuario"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:importantForAccessibility="no"
            app:civ_border_color="@color/colorPrimary"
            app:civ_border_width="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/mascota_ronny" />

        <TextView
            android:id="@+id/tv_usuario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:textColor="@color/cafe"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/img_usuario"
            app:layout_constraintEnd_toStartOf="@id/tv_fecha"
            app:layout_constraintStart_toEndOf="@id/img_usuario"
            app:layout_constraintTop_toTopOf="@id/img_usuario"
            tools:text="\@ronny" />

        <TextView
            android:id="@+id/tv_fecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:textAppearance="?attr/textAppearanceCaption"
            app:layout_constraintBottom_toBottomOf="@id/img_usuario"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/img_usuario"
            tools:text="hace 2 horas" />

        <ImageView
            android:id="@+id/img_foto"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/img_usuario"
            tools:src="@drawable/mascota_ronny" />

        <LinearLayout
            android:id="@+id/barra_likes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/img_foto">

            <!-- Los likes de Instagram se muestran como huesos -->
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_hueso_dorado" />

            <TextView
                android:id="@+id/tv_likes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textAppearance="?attr/textAppearanceSubtitle1"
                android:textColor="@color/cafe"
                tools:text="5" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_texto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="12dp"
            android:textAppearance="?attr/textAppearanceBody2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/barra_likes"
            tools:text="Listo para el paseo de la mañana" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
