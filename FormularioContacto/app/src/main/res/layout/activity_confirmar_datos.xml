<?xml version="1.0" encoding="utf-8"?>
<!-- tools:text solo se ve en la vista previa de Android Studio. En la app los textos llegan del Intent. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margen_pantalla">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/confirmar_datos"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <TextView
            android:id="@+id/texto_nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_boton"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            tools:text="Lorena Hernández López" />

        <TextView
            android:id="@+id/texto_fecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_campos"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            tools:text="Fecha de nacimiento: 12/12/1987" />

        <TextView
            android:id="@+id/texto_telefono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_campos"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            tools:text="Tel. 55553333" />

        <TextView
            android:id="@+id/texto_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_campos"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            tools:text="Email: lorena@gmail.com" />

        <TextView
            android:id="@+id/texto_descripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_campos"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            tools:text="Descripción: Conocí a Lorena en el restaurante de comida italiana" />

        <Button
            android:id="@+id/boton_editar"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:text="@string/editar_datos" />

    </LinearLayout>
</ScrollView>
