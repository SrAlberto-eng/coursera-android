<?xml version="1.0" encoding="utf-8"?>
<!-- 04 · Registro de receta: foto, datos generales e ingredientes. El botón de guardar queda fijo abajo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/cerrar"
        app:navigationIcon="@drawable/ic_cerrar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margen"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:background="@drawable/fondo_selector_foto">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_agregar_foto"
                        app:tint="@color/texto_suave" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/agregar_foto"
                        android:textAppearance="@style/TextAppearance.PaperRecipes.CuerpoMediano"
                        android:textColor="@color/texto_suave" />
                </LinearLayout>

                <!-- Vista previa de la foto elegida. Tapa el aviso de arriba cuando hay foto. -->
                <ImageView
                    android:id="@+id/iv_foto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/desc_foto"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_galeria"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/galeria"
                    app:icon="@drawable/ic_galeria" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_camara"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/camara"
                    app:icon="@drawable/ic_camara" />
            </LinearLayout>

            <LinearLayout
                style="@style/Campo"
                android:layout_marginTop="14dp">

                <TextView
                    style="@style/Campo.Etiqueta"
                    android:labelFor="@+id/et_nombre"
                    android:text="@string/nombre_receta" />

                <EditText
                    android:id="@+id/et_nombre"
                    style="@style/Campo.Valor"
                    android:hint="@string/nombre_pista"
                    android:inputType="textCapSentences" />
            </LinearLayout>

            <LinearLayout
                style="@style/Campo"
                android:layout_marginTop="14dp">

                <TextView
                    style="@style/Campo.Etiqueta"
                    android:labelFor="@+id/et_descripcion"
                    android:text="@string/descripcion" />

                <EditText
                    android:id="@+id/et_descripcion"
                    style="@style/Campo.Valor"
                    android:hint="@string/descripcion_pista"
                    android:inputType="textCapSentences|textMultiLine" />
            </LinearLayout>

            <LinearLayout
                style="@style/Campo"
                android:layout_marginTop="14dp">

                <TextView
                    style="@style/Campo.Etiqueta"
                    android:labelFor="@+id/et_porciones"
                    android:text="@string/porciones_completa" />

                <EditText
                    android:id="@+id/et_porciones"
                    style="@style/Campo.Valor"
                    android:hint="@string/porciones_pista"
                    android:inputType="number" />
            </LinearLayout>

            <TextView
                style="@style/TituloSeccion"
                android:layout_marginTop="14dp"
                android:text="@string/ingredientes" />

            <!-- Una fila por ingrediente, con el diseño de item_editor_ingrediente.xml -->
            <LinearLayout
                android:id="@+id/contenedor_ingredientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_agregar_ingrediente"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/agregar_ingrediente"
                app:icon="@drawable/ic_agregar" />

            <TextView
                style="@style/TituloSeccion"
                android:layout_marginTop="24dp"
                android:text="@string/pasos" />

            <!-- Una fila por paso, con el diseño de item_editor_paso.xml -->
            <LinearLayout
                android:id="@+id/contenedor_pasos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_agregar_paso"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/agregar_paso"
                app:icon="@drawable/ic_agregar" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/linea_superior"
        android:paddingHorizontal="@dimen/margen"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_guardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/guardar_receta" />
    </LinearLayout>

</LinearLayout>
