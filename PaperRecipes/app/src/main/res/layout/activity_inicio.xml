<?xml version="1.0" encoding="utf-8"?>
<!-- 01 · Pantalla de inicio: logotipo al centro mientras abre la app -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="@dimen/logo_inicio"
            android:layout_height="@dimen/logo_inicio"
            android:contentDescription="@string/desc_logo"
            android:src="@drawable/ic_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/logo_paper"
            android:textAppearance="@style/TextAppearance.PaperRecipes.Display"
            android:textColor="@color/texto" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/logo_recipes"
            android:textAppearance="@style/TextAppearance.PaperRecipes.Display"
            android:textColor="@color/primario" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/eslogan"
            android:textAppearance="@style/TextAppearance.PaperRecipes.CuerpoMediano"
            android:textColor="@color/texto_suave" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:text="@string/version"
        android:textAppearance="@style/TextAppearance.PaperRecipes.EtiquetaMediana"
        android:textColor="@color/texto_suave" />

</FrameLayout>
